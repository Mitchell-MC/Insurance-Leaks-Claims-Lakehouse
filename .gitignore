# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# uv
.uv/

# Environment / secrets
.env
.env.*
!.env.example

# Databricks
.databricks/
databricks.yml.local

# Terraform
infra/**/.terraform/
infra/**/.terraform.lock.hcl
infra/**/terraform.tfstate
infra/**/terraform.tfstate.backup
infra/**/*.tfvars
!infra/**/*.tfvars.example
# Saved plan files embed resolved resource attributes -- never commit them.
infra/**/*.tfplan
infra/**/tfplan*.binary
# Local-state backend override used for laptop-only applies (see the file's
# own comment); a shared deployment must use the azurerm backend instead.
infra/**/backend_override.tf

# Power BI
*.pbix.bak
~$*.pbix

# Testing / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Mentoring brief / meta documents -- not part of the project deliverable,
# contains third-party contact info; keep local-only, never track/push.
*.pdf

# Spark
spark-warehouse/
metastore_db/
derby.log

# Local tool run logs (e.g. ad-hoc dbt CLI invocations)
logs/

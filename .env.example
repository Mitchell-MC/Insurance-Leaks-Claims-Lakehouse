# Copy to .env and override as needed. Picked up automatically by
# LakehouseSettings (env_file=".env") whether running via `uv run lakehouse`
# or `docker compose run lakehouse` (see docker-compose.yml's env_file entry).

# NWS requests a real identifying contact string -- set this before hitting
# the live NWS API (docker compose run lakehouse ingest --source nws_alerts_snapshots).
LAKEHOUSE_NWS_USER_AGENT=(your-app-name, you@example.com)

# Default when running `uv run lakehouse` directly against a real Databricks
# cluster. docker-compose.yml overrides this to a plain local Docker volume
# (file:///data/lakehouse) for the local-simulation path -- see that file's
# header comment for why a real Azure emulator (Azurite) was tried and
# rejected -- only uncomment if you want to override that too.
# LAKEHOUSE_STORAGE_ROOT=dbfs:/lakehouse
